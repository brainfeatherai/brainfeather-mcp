# Build output - regenerated by `pnpm run build`, never committed.
# prepublishOnly wipes and rebuilds this, so a stale artifact from a
# deleted source file cannot reach npm.
dist/

node_modules/
package-lock.json

# Never commit a key. The API key belongs in the MCP client's env block
# or in ~/.brainfeather/config.json, neither of which lives in this repo.
.env
.env.*
!.env.example

*.tsbuildinfo
.DS_Store
*.log
